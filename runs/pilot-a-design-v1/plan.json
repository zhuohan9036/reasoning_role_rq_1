  "claim_ceiling": "Named frozen model, response regime, and controlled task distribution only; no universal primitive, general reasoning-role, cross-domain, or causal claim.",
  "task_language": {
    "version": "0.1",
    "status": "provisional_diagnostic_instrument",
    "types": ["Symbol8", "Boolean"],
    "candidate_operations": ["transform", "merge", "predicate", "select"],
    "negative_control": "direct_read",
    "completeness_claim": false
  },
  "core_design": {
    "dimensions": {
      "dependency_topology": ["serial", "fork_join"],
      "control_source": ["externally_supplied", "computed_from_intermediate"]
