    "cells": ["C1", "C2", "C3", "C4"],
    "active_node_levels": [4, 6],
    "answer_values": 8,
    "instances_per_cell_length_answer": 16,
    "discovery_canonical_instances": 1024,
    "confirmation_canonical_instances": 1024,
    "minimum_direct_read_controls": 512,
    "paired_renderings_per_core_instance": 2
  },
  "model_policy": {
    "excluded_families": ["Qwen"],
    "working_default": "mistralai/Mistral-7B-Instruct-v0.3",
    "preferred_alternative_family": "Llama instruct approximately 8B",
    "exact_model_revision": "unresolved_full_commit_sha_required_before_execution",
    "exact_tokenizer_revision": "unresolved_full_commit_sha_required_before_execution"
  },
  "response_regimes": {
    "R1": "aligned_trace",
    "R2": "final_answer_only",
    "primary_measurement_regime": "R1"
  },
  "behavior_gate": {
    "minimum_trimmed_exact_per_task_cell_length": 0.8,
    "maximum_invalid_format_rate": 0.02,
    "all_attempts_in_denominator": true,
    "failed_cells_may_be_silently_excluded": false,
    "interpretation": "engineering_progression_rule"
  },
  "first_measurement": {
    "unit": "residual_stream_vector_at_each_aligned_R1_state_output_event_and_layer",
    "minimum_alignment_rate": 0.99,
    "head_or_mlp_capture_in_scope": false,
    "intervention_in_scope": false
  },
  "implementation_steps": [
    "freeze_machine_readable_task_specification",
    "implement_typed_canonical_programs_and_reference_interpreter",
    "implement_four_matched_cells_and_direct_read_controls",
    "implement_paired_renderings_without_operation_name_leakage",
    "generate_semantic_disjoint_discovery_confirmation_and_control_pools",
    "implement_balance_overlap_and_shortcut_audits",
    "preserve_existing_calibration_tasks_as_non_authoritative_regression_artifacts",
    "run_no_network_local_validation"
